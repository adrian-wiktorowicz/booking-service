# Azure PostgreSQL Connection String (Flexible Server)
DATABASE_URL="postgresql://journaladmin:YourPassword@psql-journal-9168.postgres.database.azure.com:5432/journaldb?sslmode=require"

# Azure Blob Storage (Photos)
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;EndpointSuffix=core.windows.net;AccountName=stjournal3957;AccountKey=YOUR_KEY;..."
AZURE_STORAGE_CONTAINER_NAME="journal-photos"

# Authentication & Security
JWT_SECRET="your-jwt-secret-uuid"
AUTH_PEPPER_SECRET="your-high-entropy-pepper-secret-stored-outside-db-eg-key-vault"

# Server Configuration
PORT=3001
NODE_ENV="development"

